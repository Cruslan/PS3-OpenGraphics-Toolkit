// =============================================================================
// PS3 RSX Test 72: Vertex Shader Dedicated Integer Constant Registers [VS 3.0]
// Discrete integer parameter vectors (i0-i15) controlling lattice subdivision,
// discrete integer modular indexing, and procedural cellular tile quantization
// =============================================================================

struct FragmentInput {
    float2 uv : TEXCOORD0;
};

struct FragmentOutput {
    float4 color : COLOR0;
};

FragmentOutput main(FragmentInput input, uniform float4 time_param) {
    FragmentOutput output;
    float t = time_param.x;
    
    // Scale UV coordinate space with positive shift
    float2 uv_shifted = input.uv * 3.5 + float2(16.0, 16.0);
    
    // Dedicated Integer Constant Parameters (simulating i0-i15 constant registers)
    int ix = (int)floor(uv_shifted.x);
    int iy = (int)floor(uv_shifted.y);
    
    // Integer classification modulo patterns
    int pattern_mode = ((ix * 3) + (iy * 5)) % 4;
    if (pattern_mode < 0) {
        pattern_mode += 4;
    }
    int tile_id = ix + (iy * 7);
    
    // Fractional intra-cell coordinates
    float2 cell_frac = frac(uv_shifted);
    float2 cell_center = cell_frac - float2(0.5, 0.5);
    float dist_to_center = length(cell_center);
    float d_border = min(min(cell_frac.x, 1.0 - cell_frac.x), min(cell_frac.y, 1.0 - cell_frac.y));
    
    // Vibrant distinct material colors based on integer modulo index
    float3 base_color;
    if (pattern_mode == 0) {
        base_color = float3(0.95, 0.25, 0.20); // Crimson Red
    } else if (pattern_mode == 1) {
        base_color = float3(0.15, 0.85, 0.40); // Emerald Green
    } else if (pattern_mode == 2) {
        base_color = float3(0.20, 0.55, 0.95); // Sapphire Blue
    } else {
        base_color = float3(0.95, 0.80, 0.15); // Golden Amber
    }
    
    // Pulse intensity modulated by discrete integer tile id
    float pulse = sin(t * 3.0 + (float)tile_id * 0.45) * 0.5 + 0.5;
    float3 final_color = base_color * (0.35 + 0.65 * (1.0 - dist_to_center * 1.15)) * (0.75 + 0.25 * pulse);
    
    // Draw crisp dark grid borders
    if (d_border < 0.06) {
        final_color = float3(0.08, 0.08, 0.12);
    }
    
    output.color = float4(final_color, 1.0);
    return output;
}
