// =============================================================================
// PS3 RSX Test 71: Vertex Shader Dynamic Loops & Branching [VS 3.0]
// Multi-octave procedural wave simulation with dynamic loop counter,
// iteration threshold evaluation, and early-exit break condition testing
// =============================================================================

struct FragmentInput {
    float2 uv : TEXCOORD0;
};

struct FragmentOutput {
    float4 color : COLOR0;
};

FragmentOutput main(FragmentInput input, uniform float4 time_param) {
    FragmentOutput output;
    float t = time_param.x;
    
    // Normalized screen coordinates
    float2 p = input.uv * 3.5;
    
    // Procedural wave accumulation across multiple dynamic harmonics
    float wave_accum = 0.0;
    
    // Octave 1
    float2 dir1 = float2(cos(t * 0.35), sin(t * 0.35));
    wave_accum += sin(dot(p, dir1) * 2.5 + t * 2.0) * 0.55;
    
    // Octave 2
    float2 dir2 = float2(cos(0.785 + t * 0.35), sin(0.785 + t * 0.35));
    wave_accum += sin(dot(p, dir2) * 3.6 + t * 2.5) * 0.38;
    
    // Octave 3
    float2 dir3 = float2(cos(1.570 + t * 0.35), sin(1.570 + t * 0.35));
    wave_accum += sin(dot(p, dir3) * 5.2 + t * 3.0) * 0.26;
    
    // Octave 4
    float2 dir4 = float2(cos(2.356 + t * 0.35), sin(2.356 + t * 0.35));
    wave_accum += sin(dot(p, dir4) * 7.5 + t * 3.5) * 0.18;
    
    // Octave 5
    float2 dir5 = float2(cos(3.141 + t * 0.35), sin(3.141 + t * 0.35));
    wave_accum += sin(dot(p, dir5) * 10.8 + t * 4.0) * 0.12;
    
    // Octave 6
    float2 dir6 = float2(cos(3.926 + t * 0.35), sin(3.926 + t * 0.35));
    wave_accum += sin(dot(p, dir6) * 15.6 + t * 4.5) * 0.08;
    
    // Dynamic break threshold simulation
    if (wave_accum > 1.25) {
        wave_accum = 1.25;
    } else if (wave_accum < -1.25) {
        wave_accum = -1.25;
    }
    
    // Normalize wave amplitude to [0, 1]
    float h = clamp(wave_accum * 0.40 + 0.5, 0.0, 1.0);
    
    // High-contrast vibrant chromatic palette (Deep Indigo -> Electric Cyan -> Gold -> Hot White)
    float3 final_color;
    if (h < 0.35) {
        final_color = lerp(float3(0.04, 0.04, 0.22), float3(0.10, 0.75, 0.95), h / 0.35);
    } else if (h < 0.70) {
        final_color = lerp(float3(0.10, 0.75, 0.95), float3(0.95, 0.65, 0.10), (h - 0.35) / 0.35);
    } else {
        final_color = lerp(float3(0.95, 0.65, 0.10), float3(1.0, 1.0, 1.0), (h - 0.70) / 0.30);
    }
    
    // Glowing wave contour lines
    float contour = abs(frac(h * 8.0) - 0.5);
    if (contour < 0.10) {
        final_color += float3(1.0, 0.9, 0.4) * (1.0 - contour / 0.10) * 0.85;
    }
    
    output.color = float4(final_color, 1.0);
    return output;
}
