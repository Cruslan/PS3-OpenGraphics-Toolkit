// =============================================================================
// PS3 RSX Test 58: Vertex Input Attributes (v0-v15) [Vertex Shader 3.0]
// Visualizes full 16-channel vertex input attribute decoding and bus routing
// =============================================================================

struct FragmentInput {
    float2 uv : TEXCOORD0;
};

struct FragmentOutput {
    float4 color : COLOR0;
};

FragmentOutput main(FragmentInput input, uniform float4 time_param) {
    FragmentOutput output;
    float t = time_param.x;
    
    // Decompose UV into a 4x4 matrix representing 16 vertex input attribute streams (v0..v15)
    float2 grid = frac(input.uv * 2.0 + float2(t * 0.2, t * 0.1));
    float2 cell = floor(input.uv * 2.0 + 2.0);
    float attr_id = cell.x + cell.y * 4.0;
    
    // Synthesize multi-attribute stream waves (Position, Normal, Tangent, Color, TexCoords 0-7)
    float wave_a = sin(grid.x * 6.28318 + attr_id + t * 2.0);
    float wave_b = cos(grid.y * 6.28318 + attr_id * 0.5 + t);
    float pattern = abs(wave_a * wave_b);
    
    // Color mapping representing active attribute bus lanes (0 to 15)
    float3 col = float3(
        sin(attr_id * 0.392 + t) * 0.5 + 0.5,
        cos(attr_id * 0.392 + t * 1.3) * 0.5 + 0.5,
        sin(attr_id * 0.785 + 1.5) * 0.5 + 0.5
    ) * (pattern * 0.8 + 0.2);
    
    // Grid border delineation for 16-attribute array visual inspection
    float2 border = step(float2(0.05, 0.05), grid) * step(grid, float2(0.95, 0.95));
    col *= border.x * border.y;
    
    output.color = float4(col, 1.0);
    return output;
}
