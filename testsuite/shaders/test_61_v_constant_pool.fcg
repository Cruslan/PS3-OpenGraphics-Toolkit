// =============================================================================
// PS3 RSX Test 61: Vertex Constant Parameter Pool (c0-c467) [Vertex Shader 3.0]
// Multi-harmonic uniform constant parameter array indexing and modulation
// =============================================================================

struct FragmentInput {
    float2 uv : TEXCOORD0;
};

struct FragmentOutput {
    float4 color : COLOR0;
};

FragmentOutput main(FragmentInput input, uniform float4 time_param) {
    FragmentOutput output;
    float t = time_param.x;
    
    // Simulate reading multi-harmonic constant array slots c0..c467
    // Constant parameters modulate wave frequencies, amplitudes, phases, and color matrices
    float4 c_harmonics_1 = float4(1.0, 2.0, 3.0, 4.0);
    float4 c_harmonics_2 = float4(5.0, 6.0, 7.0, 8.0);
    float4 c_amplitudes  = float4(0.5, 0.25, 0.125, 0.0625);
    
    float2 p = input.uv;
    
    // Wave synthesis across uniform parameter slots
    float wave_sum = 0.0;
    wave_sum += sin(p.x * c_harmonics_1.x + t) * c_amplitudes.x;
    wave_sum += sin(p.y * c_harmonics_1.y + t * 1.2) * c_amplitudes.y;
    wave_sum += sin(p.x * c_harmonics_1.z + t * 1.4) * c_amplitudes.z;
    wave_sum += sin(p.y * c_harmonics_1.w + t * 1.6) * c_amplitudes.w;
    wave_sum += cos(p.x * c_harmonics_2.x + t * 1.8) * (c_amplitudes.x * 0.5);
    wave_sum += cos(p.y * c_harmonics_2.y + t * 2.0) * (c_amplitudes.y * 0.5);
    
    float3 col = float3(
        sin(wave_sum * 4.0 + t) * 0.5 + 0.5,
        cos(wave_sum * 4.0 + t * 1.3) * 0.5 + 0.5,
        sin(wave_sum * 8.0) * 0.5 + 0.5
    );
    
    output.color = float4(col, 1.0);
    return output;
}
