// =============================================================================
// PlayStation 3 RSX Reality Synthesizer (NVIDIA G70 / NV47) Ray Tracing Engine
// Cg Fragment Shader (Shader Model 3.0 FP32 Vector ALUs)
// Floating Mirror Sphere with Ground & Shadow Reflections
// =============================================================================

#pragma optionNV(fastprecision off)

struct FragmentInput {
    float2 uv : TEXCOORD0;
};

struct FragmentOutput {
    float4 color : COLOR0;
};

// Procedural Sky Gradient (Horizon to Zenith)
float3 evaluate_sky(float3 rd) {
    float t = saturate(0.5 * (rd.y + 1.0));
    float3 horizon = float3(0.75, 0.85, 0.95); // Soft cyan horizon
    float3 zenith  = float3(0.18, 0.42, 0.85); // Deep azure sky
    return lerp(horizon, zenith, t);
}

// Procedural Checkered Floor with Smooth Anti-Aliasing (for Sphere Reflection)
float3 get_plane_color(float3 p, float tile_size, float t, float abs_rdy) {
    float inv_tile = 1.0 / tile_size;
    float u = p.x * (0.5 * inv_tile);
    float v = p.z * (0.5 * inv_tile);
    
    /* Exact triangle wave in [-1, +1] using floor-based periodic fraction */
    float frac_u = u - floor(u);
    float frac_v = v - floor(v);
    float sx = (abs(frac_u - 0.5) - 0.25) * 4.0;
    float sz = (abs(frac_v - 0.5) - 0.25) * 4.0;
    float s  = sx * sz;
    
    /* Pixel footprint in tile space */
    float pixel_angle = 0.002;
    float footprint = (t * pixel_angle) / max(abs_rdy, 0.001);
    
    /* Dynamic transition width for anti-aliasing */
    float edge = clamp(footprint * 2.5 * inv_tile, 0.002, 1.0);
    
    /* Smooth anti-aliased step across zero-crossing */
    float check_val = clamp((s / edge) * 0.5 + 0.5, 0.0, 1.0);
    
    /* Seamless distance fade to neutral average (0.5) */
    float fade = clamp(1.5 - footprint * inv_tile, 0.0, 1.0);
    check_val = 0.5 + (check_val - 0.5) * fade;

    float3 col_light = float3(0.85, 0.85, 0.90);
    float3 col_dark  = float3(0.12, 0.15, 0.22);
    return lerp(col_dark, col_light, check_val);
}

// Shadow Ray Occlusion Test against the Reflective Sphere
float test_shadow(float3 hit_p, float3 light_p, float3 sph_center, float sph_rad_sq) {
    float3 to_light = light_p - hit_p;
    float light_dist = length(to_light);
    float3 light_dir = normalize(to_light);
    float3 shadow_orig = hit_p + light_dir * 0.002;
    float3 oc = shadow_orig - sph_center;
    float b = dot(oc, light_dir);
    float c = dot(oc, oc) - sph_rad_sq;
    float disc = b * b - c;
    float s = sqrt(max(0.0, disc));
    float t0 = -b - s;
    float t1 = -b + s;
    bool hit0 = (disc > 0.0) && (t0 > 0.001) && (t0 < light_dist);
    bool hit1 = (disc > 0.0) && (t1 > 0.001) && (t1 < light_dist);
    return (hit0 || hit1) ? 0.2 : 1.0;
}

FragmentOutput main(
    FragmentInput input,
    uniform float4 cam_pos,
    uniform float3 cam_fwd,
    uniform float3 cam_right_scaled,
    uniform float3 cam_up_scaled,
    uniform float3 sphere_pos,
    uniform float3 light_pos
) {
    FragmentOutput output;
    
    // Construct Primary Eye Ray in Camera World Space
    float3 ro = cam_pos.xyz;
    float3 rd = normalize(cam_fwd + input.uv.x * cam_right_scaled + input.uv.y * cam_up_scaled);
    
    // --- Scene Primitives & Material Constants ---
    const float3 sphere_color  = float3(0.95, 0.95, 1.0); // Polished Chromium
    const float  sphere_shin   = 64.0;
    const float  sphere_refl   = 0.85;
    const float  sphere_rad_sq = 0.81; // radius = 0.9, radius_sq = 0.81
    const float  plane_y       = -0.8;
    const float  tile_size     = 1.0;
    const float  ambient       = 0.15;
    const float  intensity     = 1.20;
    const float3 light_color   = float3(1.0, 0.98, 0.92);
    
    // Primary Sphere Intersection Test
    float3 oc = ro - sphere_pos;
    float b = dot(oc, rd);
    float c = dot(oc, oc) - sphere_rad_sq;
    float disc = b * b - c;
    float sqrt_d = sqrt(max(0.0, disc));
    float t0 = -b - sqrt_d;
    float t1 = -b + sqrt_d;
    
    bool hit_t0 = (disc > 0.0) && (t0 > 0.001);
    bool hit_t1 = (disc > 0.0) && (t1 > 0.001);
    bool hit_sphere = hit_t0 || hit_t1;
    float t_sphere = hit_t0 ? t0 : (hit_t1 ? t1 : 1e30);
    
    // Primary Ray Background: Clean Sky Gradient Everywhere
    float3 sky_color = evaluate_sky(rd);
    
    // Floating Silver Mirror Sphere Direct & Specular Lighting
    float3 hit_pos_s = ro + rd * t_sphere;
    float3 normal_s = normalize(hit_pos_s - sphere_pos);
    float3 to_light_s = normalize(light_pos - hit_pos_s);
    float diff_s = max(0.0, dot(normal_s, to_light_s));
    float3 view_dir = -rd;
    float3 half_dir = normalize(to_light_s + view_dir);
    float spec_s = pow(max(0.0, dot(normal_s, half_dir)), sphere_shin);
    float3 direct_sphere = (sphere_color * ambient) +
                           (sphere_color * light_color) * (diff_s * intensity) +
                           (light_color * spec_s);
    
    // Secondary Ray Reflection Bounce sampling both Ground Plane and Sky
    float3 r_ro = hit_pos_s + normal_s * 0.002;
    float3 r_rd = reflect(rd, normal_s);
    float3 r_sky = evaluate_sky(r_rd);
    
    float r_tp = (r_ro.y - plane_y) / max(-r_rd.y, 1e-5);
    bool r_hit_plane = (r_ro.y > plane_y) && (r_rd.y < -1e-5) && (r_tp > 0.001);
    
    float3 r_hit_pos = r_ro + r_rd * r_tp;
    float3 r_base = get_plane_color(r_hit_pos, tile_size, t_sphere + r_tp, abs(r_rd.y));
    float3 r_to_l = normalize(light_pos - r_hit_pos);
    float r_diff = max(0.0, r_to_l.y);
    float r_shadow = test_shadow(r_hit_pos, light_pos, sphere_pos, sphere_rad_sq);
    float3 r_direct = (r_base * ambient) + (r_base * light_color) * (r_diff * r_shadow * intensity);
    float r_fog = saturate((r_tp - 4.0) * 0.04);
    float3 r_plane_col = lerp(r_direct, r_sky, r_fog);
    float3 refl_color = r_hit_plane ? r_plane_col : r_sky;
    
    float3 sphere_final = lerp(direct_sphere, refl_color * sphere_color, sphere_refl);
    
    // Final Scene Composite: Only Sphere is drawn over the sky
    float3 pixel_color = hit_sphere ? sphere_final : sky_color;
    
    output.color = float4(pixel_color, 1.0);
    return output;
}

