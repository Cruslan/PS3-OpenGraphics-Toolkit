// =============================================================================
// PS3 RSX Test 76: Fragment Shader Custom Depth Output [oDepth / SM 3.0]
// Direct hardware depth replacement write (gl_FragDepth / NVFX_FP_REG_DEPTH / R1.z)
// evaluating raymarched intersecting procedural geometric planes and depth ramp
// =============================================================================

struct FragmentInput {
    float2 uv : TEXCOORD0;
};

struct FragmentOutput {
    float4 color : COLOR0;
    float depth : DEPTH;
};

FragmentOutput main(FragmentInput input, uniform float4 time_param) {
    FragmentOutput output;
    float t = time_param.x;
    
    // Normalized screen coordinate space
    float2 p = input.uv * 2.0;
    
    // Analytical perspective undulating terrain surface boundary: y = -0.15 + 0.35 * sin(p.x * 3.5 + t * 1.5) * cos(p.x * 2.0 - t);
    float terrain_boundary = -0.15 + 0.35 * sin(p.x * 3.5 + t * 1.5) * cos(p.x * 2.0 - t);
    
    float3 final_color;
    float custom_depth;
    
    if (p.y <= terrain_boundary) {
        // Pixel is on the undulating 3D terrain surface
        float depth_gradient = clamp((terrain_boundary - p.y) * 1.2, 0.0, 1.0);
        
        // Continuous non-linear depth function mapped to hardware clip space [0.1, 0.95]
        custom_depth = clamp(0.15 + 0.75 * depth_gradient, 0.0, 1.0);
        
        // Multi-spectral chromatic depth ramp (Cyan -> Green -> Yellow -> Orange -> Magenta)
        float3 depth_ramp = 0.5 + 0.5 * cos(float3(0.0, 2.0, 4.0) + depth_gradient * 6.28 + t);
        
        // Analytical surface normal for dynamic Blinn-Phong lighting
        float grad_x = -0.35 * (3.5 * cos(p.x * 3.5 + t * 1.5) * cos(p.x * 2.0 - t) - 2.0 * sin(p.x * 3.5 + t * 1.5) * sin(p.x * 2.0 - t));
        float3 norm = normalize(float3(grad_x, 1.0, 0.6));
        
        float3 light_dir = normalize(float3(0.5, 1.2, 0.8));
        float diff = max(0.0, dot(norm, light_dir));
        float spec = pow(max(0.0, dot(norm, normalize(light_dir + float3(0.0, 0.0, 1.0)))), 24.0);
        
        // Superimpose fine white isodepth contour rings
        float contour = abs(frac(custom_depth * 28.0) - 0.5);
        float contour_line = step(contour, 0.10);
        
        final_color = depth_ramp * (0.35 + 0.65 * diff) + float3(1.0, 1.0, 1.0) * spec * 0.5 + float3(1.0, 1.0, 1.0) * contour_line * 0.6;
    } else {
        // Sky backdrop with deep atmospheric gradient
        float sky_t = clamp((p.y - terrain_boundary) / 1.5, 0.0, 1.0);
        final_color = lerp(float3(0.12, 0.22, 0.38), float3(0.04, 0.06, 0.12), sky_t);
        custom_depth = 1.0;
    }
    
    output.color = float4(final_color, 1.0);
    output.depth = custom_depth;
    return output;
}
