// =============================================================================
// PS3 RSX Test 82: Hardware Lighting & Attenuation Coefficients [LIT / DST / SM 3.0]
// Native Blinn-Phong lighting evaluator (LIT: [1, N.L, (N.H)^shininess, 1]) and
// quadratic distance vector attenuation (DST: [1, d, d^2, 1/d]) across multi-light scene
// =============================================================================

struct FragmentInput {
    float2 uv : TEXCOORD0;
};

struct FragmentOutput {
    float4 color : COLOR0;
};

// Emulates RSX native LIT instruction: coefficients = lit(n_dot_l, n_dot_h, shininess)
// lit.x = 1.0 (ambient factor)
// lit.y = max(0.0, n_dot_l) (diffuse factor)
// lit.z = (n_dot_l > 0.0) ? pow(max(0.0, n_dot_h), shininess) : 0.0 (specular factor)
// lit.w = 1.0
float4 rsx_lit(float n_dot_l, float n_dot_h, float shininess) {
    float ambient = 1.0;
    float diffuse = max(0.0, n_dot_l);
    float specular = (diffuse > 0.0) ? pow(max(0.0, n_dot_h), shininess) : 0.0;
    return float4(ambient, diffuse, specular, 1.0);
}

// Emulates RSX native DST instruction: vector = dst(dist)
// dst.x = 1.0 (constant attenuation term)
// dst.y = d (linear attenuation term)
// dst.z = d^2 (quadratic attenuation term)
// dst.w = 1.0 / d (inverse distance)
float4 rsx_dst(float d) {
    return float4(1.0, d, d * d, 1.0 / max(0.001, d));
}

FragmentOutput main(FragmentInput input, uniform float4 time_param) {
    FragmentOutput output;
    float t = time_param.x;
    
    // Scale UV for 3D sphere surface evaluation
    float2 p = input.uv * 1.6;
    float r2 = dot(p, p);
    
    // Background check
    if (r2 > 1.0) {
        float bg_grad = clamp(1.0 - length(input.uv) * 0.6, 0.0, 1.0);
        output.color = float4(float3(0.04, 0.06, 0.10) * bg_grad, 1.0);
        return output;
    }
    
    // 3D Sphere geometry
    float z = sqrt(1.0 - r2);
    float3 pos = float3(p.x, p.y, z);
    float3 normal = normalize(pos);
    float3 view_dir = float3(0.0, 0.0, 1.0);
    
    // Multi-light configuration:
    // Light 1 (Orbiting Cyan Key Light): High-intensity specular omni light
    // Light 2 (Orbiting Amber Fill Light): Softer warm fill light
    float3 light1_pos = float3(sin(t * 1.5) * 1.8, cos(t * 1.5) * 1.8, 1.2);
    float3 light2_pos = float3(sin(t * 1.0 + 3.14) * 2.0, cos(t * 1.0 + 3.14) * 0.8, 1.5);
    
    float3 light1_color = float3(0.1, 0.8, 1.0);
    float3 light2_color = float3(1.0, 0.6, 0.1);
    
    // Attenuation coefficients: [k_constant, k_linear, k_quadratic, 0.0]
    float4 atten_coeffs1 = float4(1.0, 0.5, 0.25, 0.0);
    float4 atten_coeffs2 = float4(1.0, 0.3, 0.15, 0.0);
    
    float3 total_lit = float3(0.0, 0.0, 0.0);
    
    // -------------------------------------------------------------------------
    // Evaluate Light 1 using native LIT + DST
    // -------------------------------------------------------------------------
    float3 l1_vec = light1_pos - pos;
    float l1_dist = length(l1_vec);
    float3 l1_dir = l1_vec / l1_dist;
    
    float4 dst1 = rsx_dst(l1_dist);
    float atten1 = 1.0 / dot(atten_coeffs1, dst1);
    
    float3 h1 = normalize(l1_dir + view_dir);
    float4 lit1 = rsx_lit(dot(normal, l1_dir), dot(normal, h1), 48.0);
    
    // Material 1: Ambient (0.1) + Diffuse (0.7) + Specular (0.9)
    total_lit += light1_color * (lit1.x * 0.05 + lit1.y * 0.65 + lit1.z * 0.9) * atten1;
    
    // -------------------------------------------------------------------------
    // Evaluate Light 2 using native LIT + DST
    // -------------------------------------------------------------------------
    float3 l2_vec = light2_pos - pos;
    float l2_dist = length(l2_vec);
    float3 l2_dir = l2_vec / l2_dist;
    
    float4 dst2 = rsx_dst(l2_dist);
    float atten2 = 1.0 / dot(atten_coeffs2, dst2);
    
    float3 h2 = normalize(l2_dir + view_dir);
    float4 lit2 = rsx_lit(dot(normal, l2_dir), dot(normal, h2), 24.0);
    
    total_lit += light2_color * (lit2.x * 0.05 + lit2.y * 0.65 + lit2.z * 0.7) * atten2;
    
    // Base albedo modulation
    float3 albedo = float3(0.8, 0.85, 0.9);
    float3 final_color = albedo * total_lit;
    
    output.color = float4(final_color, 1.0);
    return output;
}
