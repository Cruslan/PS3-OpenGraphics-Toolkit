// =============================================================================
// PS3 RSX Test 67: Vertex Fog Factor Output (FOGC / o[5]) [Vertex Shader 3.0]
// Atmospheric depth haze blending via linear and exponential fog equations
// =============================================================================

struct FragmentInput {
    float2 uv : TEXCOORD0;
};

struct FragmentOutput {
    float4 color : COLOR0;
};

FragmentOutput main(FragmentInput input, uniform float4 time_param) {
    FragmentOutput output;
    float t = time_param.x;
    
    // Simulate depth-based atmospheric fog factor (oFog / FOGC)
    // Distance increases towards the horizon
    float depth = 1.0 / (abs(input.uv.y - 0.2) + 0.1);
    
    // Evaluate exponential fog factor: f = exp(-density * depth)
    float fog_density = 0.15 + 0.05 * sin(t * 2.0);
    float fog_factor = clamp(exp(-fog_density * depth), 0.0, 1.0);
    
    // Landscape terrain color bands
    float3 terrain_col = float3(
        sin(input.uv.x * 10.0) * 0.3 + 0.4,
        cos(depth * 0.5) * 0.3 + 0.5,
        0.2
    );
    
    // Atmospheric sky and haze color
    float3 fog_col = float3(0.65, 0.75, 0.90);
    
    // Blend terrain into atmospheric fog volume using computed vertex fog factor
    float3 result = lerp(fog_col, terrain_col, fog_factor);
    
    output.color = float4(result, 1.0);
    return output;
}
