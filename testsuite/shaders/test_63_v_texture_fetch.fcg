// =============================================================================
// PS3 RSX Test 63: Vertex Texture Fetch / VTF (s0-s3 / TXL) [Vertex Shader 3.0]
// Topographic elevation field & surface normal relief sampling
// =============================================================================

struct FragmentInput {
    float2 uv : TEXCOORD0;
};

struct FragmentOutput {
    float4 color : COLOR0;
};

FragmentOutput main(FragmentInput input, uniform float4 time_param) {
    FragmentOutput output;
    float t = time_param.x;
    
    // Simulate sampling a 2D heightfield texture via VTF unit (tex2Dlod / TXL)
    float2 p = input.uv * 3.0;
    
    // Multi-octave procedural elevation texture synthesis
    float height = sin(p.x * 2.0 + t) * cos(p.y * 2.0 - t) * 0.5;
    height += sin(p.x * 4.0 - t * 1.5) * cos(p.y * 4.0 + t * 1.5) * 0.25;
    height += sin(p.x * 8.0 + t * 2.0) * cos(p.y * 8.0 - t * 2.0) * 0.125;
    
    // Derive surface relief normals from heightfield gradients
    float eps = 0.05;
    float h_r = sin((p.x + eps) * 2.0 + t) * cos(p.y * 2.0 - t) * 0.5;
    float h_u = sin(p.x * 2.0 + t) * cos((p.y + eps) * 2.0 - t) * 0.5;
    float3 normal = normalize(float3((height - h_r) / eps, (height - h_u) / eps, 1.0));
    
    // Light direction and diffuse shading over displaced terrain relief
    float3 light_dir = normalize(float3(sin(t), cos(t), 1.0));
    float diff = max(0.0, dot(normal, light_dir));
    
    // Elevation isoline contour rings
    float isolines = frac(height * 6.0);
    float contour = step(0.1, isolines) * step(isolines, 0.9);
    
    float3 col = float3(0.2, 0.6, 0.8) * diff * contour + float3(height * 0.3 + 0.1, height * 0.2, 0.1);
    
    output.color = float4(col, 1.0);
    return output;
}
