// =============================================================================
// PS3 RSX Test 59: Vertex Output Registers (o0-o15) [Vertex Shader 3.0]
// Multi-channel rasterizer interpolator routing: Position, Colors, TexCoords
// =============================================================================

struct FragmentInput {
    float2 uv : TEXCOORD0;
};

struct FragmentOutput {
    float4 color : COLOR0;
};

FragmentOutput main(FragmentInput input, uniform float4 time_param) {
    FragmentOutput output;
    float t = time_param.x;
    
    // Simulate 16 vertex output interpolators (o0: Pos, o2-o3: Colors, o7-o14: TexCoords)
    float2 uv = input.uv;
    
    // Interpolator channel 1: Primary position projection wave
    float o_pos = sin(uv.x * 4.0 + t) * cos(uv.y * 4.0 - t);
    
    // Interpolator channels 2 & 3: Diffuse & Specular vertex color ramps
    float3 o_col0 = float3(sin(uv.x * 2.0 + t) * 0.5 + 0.5, cos(uv.y * 2.0 + t) * 0.5 + 0.5, 0.8);
    float3 o_col1 = float3(0.9, sin(t * 3.0) * 0.4 + 0.5, cos(t * 2.0) * 0.4 + 0.5);
    
    // Interpolator channels 7..14: Multi-frequency rotated UV coordinates
    float angle = t * 0.5;
    float2 rot_uv = float2(uv.x * cos(angle) - uv.y * sin(angle), uv.x * sin(angle) + uv.y * cos(angle));
    float o_tc = sin(rot_uv.x * 8.0) * sin(rot_uv.y * 8.0);
    
    // Synthesize blended output representing active interpolator bus
    float3 result = lerp(o_col0, o_col1, abs(o_pos)) * (o_tc * 0.5 + 0.5);
    
    output.color = float4(result, 1.0);
    return output;
}
