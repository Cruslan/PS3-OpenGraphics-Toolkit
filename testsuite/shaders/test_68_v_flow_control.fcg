// =============================================================================
// PS3 RSX Test 68: Vertex Static Flow Control (Call Stack) [Vertex Shader 3.0]
// Multi-pass subroutine invocation accumulating ambient, diffuse & specular light
// =============================================================================

struct FragmentInput {
    float2 uv : TEXCOORD0;
};

struct FragmentOutput {
    float4 color : COLOR0;
};

// Subroutine 1: Ambient light calculation
float3 compute_ambient(float3 base_color) {
    return base_color * 0.25;
}

// Subroutine 2: Diffuse light calculation
float3 compute_diffuse(float3 normal, float3 light_dir, float3 light_color) {
    float n_dot_l = max(0.0, dot(normal, light_dir));
    return light_color * n_dot_l;
}

// Subroutine 3: Specular light calculation
float3 compute_specular(float3 normal, float3 light_dir, float3 view_dir, float shininess) {
    float3 half_vec = normalize(light_dir + view_dir);
    float n_dot_h = max(0.0, dot(normal, half_vec));
    float spec = pow(n_dot_h, shininess);
    return float3(1.0, 1.0, 1.0) * spec;
}

FragmentOutput main(FragmentInput input, uniform float4 time_param) {
    FragmentOutput output;
    float t = time_param.x;
    
    // Procedural sphere normal
    float2 p = input.uv * 1.5;
    float r2 = dot(p, p);
    
    if (r2 > 1.0) {
        output.color = float4(0.05, 0.08, 0.12, 1.0);
        return output;
    }
    
    float z = sqrt(1.0 - r2);
    float3 normal = normalize(float3(p.x, p.y, z));
    float3 view_dir = float3(0.0, 0.0, 1.0);
    
    float3 light1_dir = normalize(float3(sin(t * 2.0), cos(t * 2.0), 1.0));
    float3 light1_col = float3(0.9, 0.4, 0.2);
    
    float3 light2_dir = normalize(float3(-sin(t * 1.5), -cos(t * 1.5), 0.8));
    float3 light2_col = float3(0.2, 0.6, 0.9);
    
    float3 base_col = float3(0.8, 0.8, 0.8);
    
    // Accumulate results by executing modular lighting subroutines (simulating CAL / RET)
    float3 final_color = compute_ambient(base_col);
    final_color += compute_diffuse(normal, light1_dir, light1_col);
    final_color += compute_specular(normal, light1_dir, view_dir, 32.0) * 0.7;
    final_color += compute_diffuse(normal, light2_dir, light2_col);
    final_color += compute_specular(normal, light2_dir, view_dir, 16.0) * 0.5;
    
    output.color = float4(final_color, 1.0);
    return output;
}
