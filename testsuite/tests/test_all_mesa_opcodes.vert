VERT
DCL IN[0], POSITION
DCL IN[1], NORMAL
DCL IN[2], COLOR
DCL CONST[0], matrix[0]
DCL CONST[1], matrix[1]
DCL CONST[2], matrix[2]
DCL CONST[3], matrix[3]
DCL CONST[4], params
IMM[0] FLT32 { 0.5, 2.0, 1.0, 0.0 }
DCL OUT[0], POSITION
DCL OUT[1], COLOR

DP4 OUT[0].x, IN[0], CONST[0]
DP4 OUT[0].y, IN[0], CONST[1]
DP4 OUT[0].z, IN[0], CONST[2]
DP4 OUT[0].w, IN[0], CONST[3]

# Scalar ALU opcodes
RCP TEMP[0].x, IN[1].x
RSQ TEMP[1].x, IN[1].y
EX2 TEMP[2].x, IN[1].z
LG2 TEMP[3].x, IN[1].w
SIN TEMP[4].x, IN[2].x
COS TEMP[5].x, IN[2].y
LIT TEMP[6], IN[1]

# Vector ALU opcodes
FMA TEMP[7], TEMP[0], TEMP[1], TEMP[2]
SQRT TEMP[8], TEMP[3]
ROUND TEMP[9], TEMP[4]
CEIL TEMP[10], TEMP[5]
TRUNC TEMP[11], TEMP[6]
UADD TEMP[12], TEMP[7], TEMP[8]
UMUL TEMP[13], TEMP[9], TEMP[10]
UMAD TEMP[14], TEMP[11], TEMP[12], TEMP[13]
UCMP TEMP[15], TEMP[14], TEMP[7], TEMP[8]
FSLT TEMP[16], TEMP[15], IMM[0]
FSGE TEMP[17], TEMP[16], CONST[4]

MAD OUT[1], TEMP[17], IN[2], IMM[0]
END
