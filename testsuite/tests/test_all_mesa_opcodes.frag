FRAG
DCL IN[0], COLOR
DCL IN[1], GENERIC[0]
DCL CONST[0], lightParams
IMM[0] FLT32 { 1.0, 0.5, 0.25, 0.0 }
DCL OUT[0], COLOR

# Sample and Texture Opcodes
SAMPLE TEMP[0], IN[1], SAMP[0], 2D
TXL2 TEMP[1], IN[1], SAMP[1], 2D
DDX_FINE TEMP[2], TEMP[0]
DDY_FINE TEMP[3], TEMP[1]

# Math / ALU
FMA TEMP[4], TEMP[2], TEMP[3], IMM[0]
ROUND TEMP[5], TEMP[4]
CEIL TEMP[6], TEMP[5]
TRUNC TEMP[7], TEMP[6]
SQRT TEMP[8], TEMP[7]
POW TEMP[9], TEMP[8], IMM[0]
LIT TEMP[10], TEMP[9]
DIV TEMP[11], TEMP[10], IMM[0]
UADD TEMP[12], TEMP[11], TEMP[0]
UMUL TEMP[13], TEMP[12], TEMP[1]
UMAD TEMP[14], TEMP[13], TEMP[2], IMM[0]
UCMP TEMP[15], TEMP[14], TEMP[0], TEMP[1]
FSLT TEMP[16], TEMP[15], CONST[0]
FSGE TEMP[17], TEMP[16], IN[0]

MAD OUT[0], TEMP[17], TEMP[0], IMM[0]
END
